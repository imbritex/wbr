import {
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    Typography,
} from "@material";
import { FeaturedModCardData } from "../adapter.slint";
import { EngineIcons, OutlinedIcons } from "../icons.slint";

component CarouselSlide {
    in property <FeaturedModCardData> item;
    in property <float> w_pct;
    in property <float> x_pct;
    in property <bool> compact: false;
    in property <length> container_width;

    function resolve_engine_icon(eid: string) -> image {
        if eid == "psych" { return EngineIcons.psych; }
        if eid == "codename" { return EngineIcons.codename; }
        if eid == "vslice" { return EngineIcons.vslice; }
        if eid == "pslice" { return EngineIcons.pslice; }
        if eid == "executable" { return EngineIcons.executable; }
        if eid == "fpsplus" { return EngineIcons.fpsplus; }
        if eid == "psychonline" { return EngineIcons.psychonline; }
        return EngineIcons.vslice;
    }

    property <bool> show_engine_icon: root.item.engine_id == "psych"
        || root.item.engine_id == "codename"
        || root.item.engine_id == "vslice"
        || root.item.engine_id == "pslice"
        || root.item.engine_id == "executable"
        || root.item.engine_id == "fpsplus"
        || root.item.engine_id == "psychonline";

    property <float> content_opacity: root.compact
        ? clamp((root.w_pct - 20.0) / 70.0, 0.0, 1.0)
        : clamp((root.w_pct - 15.0) / 65.0, 0.0, 1.0);

    // Keep image at hero width so shrinking/expanding pills only clip without rescaling every frame
    property <length> hero_width: root.container_width * (root.compact ? 0.9 : 0.8);

    x: root.container_width * (root.x_pct / 100.0);
    y: 0px;
    width: root.container_width * (root.w_pct / 100.0);
    height: 100%;
    visible: root.w_pct > 0.2;

    HorizontalLayout {
        padding_left: root.compact ? 4px : 6px;
        padding_right: root.compact ? 4px : 6px;

        card := Rectangle {
            width: 100%;
            height: 100%;
            border_radius: root.compact ? 22px : 28px;
            background: MaterialPalette.surface_container;
            border_width: 1px;
            border_color: MaterialPalette.outline_variant;
            clip: true;

            if root.item.has_cover : Image {
                x: (parent.width - self.width) / 2;
                y: 0px;
                width: max(parent.width, root.hero_width);
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
            }

            // Bottom gradient for title/author readability
            if root.content_opacity > 0.02 : Rectangle {
                width: 100%;
                height: 100%;
                opacity: root.content_opacity;
                background: @linear-gradient(180deg, #00000000 0%, #00000066 55%, #000000EB 100%);
            }

            // Top-left category badge pill
            if root.item.badge != "" && root.content_opacity > 0.02 : Rectangle {
                x: root.compact ? 14px : 24px;
                y: root.compact ? 14px : 24px;
                width: badge_text.preferred-width + 24px;
                height: 30px;
                border_radius: 15px;
                background: #00000075;
                border_width: 1px;
                border_color: #FFFFFF22;
                opacity: root.content_opacity;

                badge_text := MaterialText {
                    text: root.item.badge;
                    font_size: 12px;
                    font_weight: 600;
                    color: #FFFFFF;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                }
            }

            // Bottom-left engine icon, title & author (matching wb-rew FeaturedModSlide)
            if root.content_opacity > 0.02 : HorizontalLayout {
                x: 0px;
                y: parent.height - self.preferred-height;
                width: 100%;
                padding: root.compact ? 16px : 28px;
                spacing: root.compact ? 12px : 18px;
                opacity: root.content_opacity;

                if root.show_engine_icon : VerticalLayout {
                    alignment: center;
                    Image {
                        width: root.compact ? 40px : 52px;
                        height: root.compact ? 40px : 52px;
                        source: root.resolve_engine_icon(root.item.engine_id);
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    MaterialText {
                        text: root.item.title;
                        font_size: root.compact ? 18px : 26px;
                        font_weight: 700;
                        color: #FFFFFF;
                        overflow: elide;
                    }

                    MaterialText {
                        text: root.item.author != "" ? "By " + root.item.author : "By Community";
                        font_size: root.compact ? 12px : 14px;
                        font_weight: 500;
                        color: #E0E0E0;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component FeaturedCarousel {
    in property <[FeaturedModCardData]> items;
    in property <bool> loading: false;
    in property <bool> compact: false;

    callback mod_clicked(id: string);

    property <float> visual_progress: 0.0;
    animate visual_progress { duration: 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    property <int> item_count: root.items.length;
    property <int> p_lower: floor(root.visual_progress);
    property <float> fraction: root.visual_progress - root.p_lower;
    property <int> active_index: root.item_count > 0
        ? Math.mod(round(root.visual_progress) + root.item_count * 1000, root.item_count)
        : 0;
    property <string> active_badge: root.item_count > 0 ? root.get_item(root.active_index).badge : "";

    property <int> auto_elapsed_ms: 0;
    property <float> auto_progress: clamp(root.auto_elapsed_ms / 4500.0, 0.0, 1.0);

    function get_item(idx: int) -> FeaturedModCardData {
        if root.item_count <= 0 {
            return { id: "", title: "", author: "", engine_id: "", engine: "", badge: "", cover: OutlinedIcons.home, has_cover: false };
        }
        return root.items[Math.mod(idx + root.item_count * 1000, root.item_count)];
    }

    function next() {
        if root.item_count > 1 {
            root.auto_elapsed_ms = 0;
            root.visual_progress = round(root.visual_progress) + 1.0;
        }
    }

    function prev() {
        if root.item_count > 1 {
            root.auto_elapsed_ms = 0;
            root.visual_progress = round(root.visual_progress) - 1.0;
        }
    }

    function go_to(target: int) {
        if root.item_count > 1 {
            root.auto_elapsed_ms = 0;
            root.visual_progress = round(root.visual_progress) + (target - root.active_index);
        }
    }

    auto_timer := Timer {
        interval: 50ms;
        running: root.item_count > 1;
        triggered => {
            root.auto_elapsed_ms += 50;
            if root.auto_elapsed_ms >= 4500 {
                root.next();
            }
        }
    }

    VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_12;

        HorizontalLayout {
            alignment: space-between;

            MaterialText {
                text: "Featured Mods";
                style: Typography.title_large;
                color: MaterialPalette.on_background;
            }

            if root.item_count > 0 : MaterialText {
                text: root.active_badge != "" ? root.active_badge : ((root.active_index + 1) + " / " + root.item_count);
                style: Typography.label_medium;
                color: MaterialPalette.on_surface_variant;
                vertical_alignment: center;
            }
        }

        if root.loading && root.item_count == 0 : Rectangle {
            height: clamp(self.width * (root.compact ? 0.56 : 0.46), 220px, 520px);
            border_radius: root.compact ? 22px : 28px;
            background: MaterialPalette.surface_container;
            border_width: 1px;
            border_color: MaterialPalette.outline_variant;

            MaterialText {
                text: "Cargando mods destacados de GameBanana...";
                style: Typography.body_large;
                color: MaterialPalette.on_surface_variant;
                horizontal_alignment: center;
                vertical_alignment: center;
            }
        }

        if root.item_count > 0 : VerticalLayout {
            spacing: 12px;

            // Material 3 Expressive Carousel Viewport (Desktop: 10-80-10, Mobile: 90-10)
            viewport := Rectangle {
                width: 100%;
                height: clamp(self.width * (root.compact ? 0.56 : 0.46), 220px, 520px);
                clip: true;

                if root.item_count == 1 : CarouselSlide {
                    item: root.get_item(0);
                    w_pct: 100.0;
                    x_pct: 0.0;
                    compact: root.compact;
                    container_width: viewport.width;
                }

                // Slot A: Left pill (Desktop 10% -> 0%, Mobile hidden)
                if root.item_count > 1 : CarouselSlide {
                    item: root.get_item(root.p_lower - 1);
                    x_pct: 0.0;
                    w_pct: root.compact ? 0.0 : max(0.0, 10.0 - 10.0 * root.fraction);
                    compact: root.compact;
                    container_width: viewport.width;
                }

                // Slot B: Active center card (Desktop 80% -> 10%, Mobile 90% -> 0%)
                if root.item_count > 1 : CarouselSlide {
                    item: root.get_item(root.p_lower);
                    x_pct: root.compact ? 0.0 : (10.0 - 10.0 * root.fraction);
                    w_pct: root.compact ? max(0.0, 90.0 - 90.0 * root.fraction) : max(0.0, 80.0 - 70.0 * root.fraction);
                    compact: root.compact;
                    container_width: viewport.width;
                }

                // Slot C: Right preview pill (Desktop 10% -> 80%, Mobile 10% -> 90%)
                if root.item_count > 1 : CarouselSlide {
                    item: root.get_item(root.p_lower + 1);
                    x_pct: root.compact ? (90.0 - 90.0 * root.fraction) : (90.0 - 80.0 * root.fraction);
                    w_pct: root.compact ? min(90.0, 10.0 + 80.0 * root.fraction) : min(80.0, 10.0 + 70.0 * root.fraction);
                    compact: root.compact;
                    container_width: viewport.width;
                }

                // Slot D: Entering right pill (0% -> 10%)
                if root.item_count > 1 : CarouselSlide {
                    item: root.get_item(root.p_lower + 2);
                    x_pct: 100.0 - 10.0 * root.fraction;
                    w_pct: min(10.0, 10.0 * root.fraction);
                    compact: root.compact;
                    container_width: viewport.width;
                }

                swipe_area := TouchArea {
                    property <length> drag_start_x: 0px;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            self.drag_start_x = self.mouse-x;
                        } else if event.kind == PointerEventKind.up {
                            if (self.mouse-x - self.drag_start_x) < -36px {
                                root.next();
                            } else if (self.mouse-x - self.drag_start_x) > 36px {
                                root.prev();
                            } else if !root.compact && self.mouse-x < viewport.width * 0.1 {
                                root.prev();
                            } else if self.mouse-x > viewport.width * 0.9 {
                                root.next();
                            } else {
                                root.mod_clicked(root.get_item(root.active_index).id);
                            }
                        }
                    }
                }
            }

            // Carousel controls & category-filtered expressive pill indicators (with progress fill)
            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                IconButton {
                    icon: OutlinedIcons.chevron_left;
                    tooltip: "Previous";
                    enabled: root.item_count > 1;
                    clicked => {
                        root.prev();
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 0px;

                    for item[idx] in root.items : HorizontalLayout {
                        if root.active_badge == "" || item.badge == root.active_badge : HorizontalLayout {
                            padding_left: 3px;
                            padding_right: 3px;

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: idx == root.active_index ? 44px : 10px;
                                    height: 10px;
                                    border_radius: 5px;
                                    background: MaterialPalette.surface_container_highest;
                                    border_width: 1px;
                                    border_color: MaterialPalette.outline_variant;
                                    clip: true;

                                    animate width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

                                    if idx == root.active_index : Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * root.auto_progress;
                                        height: 100%;
                                        border_radius: 5px;
                                        background: MaterialPalette.primary;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.go_to(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                IconButton {
                    icon: OutlinedIcons.chevron_right;
                    tooltip: "Next";
                    enabled: root.item_count > 1;
                    clicked => {
                        root.next();
                    }
                }
            }
        }
    }
}
