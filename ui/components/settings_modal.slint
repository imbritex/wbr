import {
    FilledButton,
    HorizontalDivider,
    IconButton,
    MaterialPalette,
    MaterialText,
    OutlineButton,
    TonalButton,
    Typography,
} from "@material";
import { MainWindowAdapter } from "../adapter.slint";
import { FilledIcons, OutlinedIcons } from "../icons.slint";

export component SettingsModal {
    width: 100%;
    height: 100%;
    visible: MainWindowAdapter.settings_open;

    if MainWindowAdapter.settings_open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;

        FocusScope {
            x: 0px;
            width: 0px;
            key_pressed(event) => {
                if event.text == Key.Escape {
                    MainWindowAdapter.close_settings();
                    return accept;
                }
                reject
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;

            clicked => {
                MainWindowAdapter.close_settings();
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 32px, 480px);
            border_radius: 28px;
            background: MaterialPalette.surface_container_high;
            border_width: 1px;
            border_color: MaterialPalette.outline_variant;
            clip: true;

            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    alignment: space-between;

                    MaterialText {
                        text: "Settings";
                        style: Typography.headline_small;
                        font_weight: 700;
                        color: MaterialPalette.on_surface;
                        vertical_alignment: center;
                    }

                    IconButton {
                        icon: OutlinedIcons.close;
                        tooltip: "Close";
                        clicked => {
                            MainWindowAdapter.close_settings();
                        }
                    }
                }

                // Application Theme
                VerticalLayout {
                    spacing: 6px;

                    MaterialText {
                        text: "Application Theme";
                        style: Typography.title_small;
                        font_weight: 600;
                        color: MaterialPalette.on_surface;
                    }

                    MaterialText {
                        text: "Select the Material Design 3 visual appearance";
                        style: Typography.body_small;
                        color: MaterialPalette.on_surface_variant;
                        wrap: word_wrap;
                    }

                    HorizontalLayout {
                        padding_top: 6px;
                        spacing: 10px;
                        alignment: start;

                        if !MainWindowAdapter.dark_mode : FilledButton {
                            text: "Light Mode";
                            icon: FilledIcons.light_mode;
                            clicked => {
                                MainWindowAdapter.set_dark_mode(false);
                            }
                        }

                        if MainWindowAdapter.dark_mode : OutlineButton {
                            text: "Light Mode";
                            icon: OutlinedIcons.light_mode;
                            clicked => {
                                MainWindowAdapter.set_dark_mode(false);
                            }
                        }

                        if MainWindowAdapter.dark_mode : FilledButton {
                            text: "Dark Mode";
                            icon: FilledIcons.dark_mode;
                            clicked => {
                                MainWindowAdapter.set_dark_mode(true);
                            }
                        }

                        if !MainWindowAdapter.dark_mode : OutlineButton {
                            text: "Dark Mode";
                            icon: OutlinedIcons.dark_mode;
                            clicked => {
                                MainWindowAdapter.set_dark_mode(true);
                            }
                        }
                    }
                }

                HorizontalDivider {}

                // Library Path
                VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            MaterialText {
                                text: "Library Path";
                                style: Typography.title_small;
                                font_weight: 600;
                                color: MaterialPalette.on_surface;
                            }

                            MaterialText {
                                text: "Local storage directory for mods and engines";
                                style: Typography.body_small;
                                color: MaterialPalette.on_surface_variant;
                                wrap: word_wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;

                            TonalButton {
                                text: "Open Folder";
                                icon: OutlinedIcons.folder_open;
                                clicked => {
                                    MainWindowAdapter.open_library_folder();
                                }
                            }
                        }
                    }

                    Rectangle {
                        border_radius: 12px;
                        background: MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: MaterialPalette.outline_variant;

                        VerticalLayout {
                            padding: 10px;

                            MaterialText {
                                text: MainWindowAdapter.library_path != ""
                                    ? MainWindowAdapter.library_path
                                    : "Not configured";
                                style: Typography.body_small;
                                color: MaterialPalette.on_surface_variant;
                                wrap: word_wrap;
                            }
                        }
                    }
                }

                HorizontalDivider {}

                // About WeekBox
                HorizontalLayout {
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        MaterialText {
                            text: "About WeekBox";
                            style: Typography.title_small;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }

                        MaterialText {
                            text: "App version, architecture, and platform info";
                            style: Typography.body_small;
                            color: MaterialPalette.on_surface_variant;
                            wrap: word_wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        TonalButton {
                            text: "View Info";
                            icon: OutlinedIcons.info;
                            clicked => {
                                MainWindowAdapter.open_about_from_settings();
                            }
                        }
                    }
                }

                // Footer
                HorizontalLayout {
                    padding_top: 4px;
                    alignment: end;

                    FilledButton {
                        text: "Save & Close";
                        clicked => {
                            MainWindowAdapter.close_settings();
                        }
                    }
                }
            }
        }
    }
}
