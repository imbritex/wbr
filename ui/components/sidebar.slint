import {
    ExtendedTouchArea,
    HorizontalDivider,
    Icon,
    IconButton,
    MaterialPalette,
    MaterialText,
    NavigationItem,
    Ripple,
    StateLayer,
    VerticalDivider,
} from "@material";
import { AppAssets, FilledIcons, OutlinedIcons } from "../icons.slint";

component SidebarNavButton {
    in property <image> icon;
    in property <image> selected_icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> compact: false;
    in property <int> anim_kind: 0; // 0: home, 1: library, 2: instances, 3: news

    callback clicked();

    property <bool> bouncing: false;
    property <bool> prev_selected: root.selected;

    changed selected => {
        if root.selected && !root.prev_selected {
            root.bouncing = true;
            bounce_timer.running = true;
        }
        root.prev_selected = root.selected;
    }

    bounce_timer := Timer {
        interval: 170ms;
        running: false;
        triggered => {
            self.running = false;
            root.bouncing = false;
        }
    }

    min_width: root.compact ? 56px : 76px;
    min_height: root.compact ? 52px : 56px;

    touch_area := ExtendedTouchArea {
        clicked => {
            root.bouncing = true;
            bounce_timer.running = true;
            root.clicked();
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                alignment: center;

                // Fixed 56x32 slot so the pill can expand expressively without shifting layout
                Rectangle {
                    width: 56px;
                    height: 32px;

                    pill := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.selected ? 56px : 24px;
                        height: 32px;
                        border_radius: 16px;
                        background: root.selected ? MaterialPalette.secondary_container : transparent;

                        animate width { duration: 360ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                        animate background { duration: 180ms; }
                    }

                    state_layer := StateLayer {
                        width: 100%;
                        height: 100%;
                        background: root.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                        border_radius: 16px;
                        enabled: true;
                        has_focus: touch_area.has_focus;
                        has_hover: touch_area.has_hover;
                        pressed: touch_area.pressed || touch_area.enter_pressed;

                        if touch_area.pressed && !root.selected : Ripple {
                            width: parent.width;
                            height: parent.height;
                            border_radius: 16px;
                            pressed_x: touch_area.pressed_x;
                            pressed_y: touch_area.pressed_y;
                            color: MaterialPalette.on_surface;
                        }
                    }

                    Icon {
                        property <length> base_size: root.bouncing ? 27px : (touch_area.has_hover && !root.selected ? 25.5px : 24px);
                        property <length> jump_y: root.bouncing ? (root.anim_kind == 2 ? -5px : -4px) : (touch_area.has_hover && !root.selected ? -1.5px : 0px);
                        property <angle> tilt: root.bouncing ? (root.anim_kind == 1 ? -10deg : root.anim_kind == 3 ? 6deg : -5deg) : 0deg;

                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + self.jump_y;
                        width: self.base_size;
                        height: self.base_size;
                        transform-rotation: self.tilt;
                        source: root.selected ? root.selected_icon : root.icon;
                        colorize: root.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;

                        animate y { duration: 320ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                        animate width { duration: 320ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                        animate height { duration: 320ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                        animate transform-rotation { duration: 360ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }

            MaterialText {
                text: root.text;
                font_size: root.compact ? 10px : 11px;
                font_weight: root.selected ? 700 : 500;
                color: root.selected ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                horizontal_alignment: center;
                overflow: elide;

                animate color { duration: 180ms; }
            }
        }
    }
}

component SidebarActionButton {
    in property <image> icon;
    in property <image> active_icon;
    in property <bool> active: false;
    in property <bool> spin_on_click: false;
    in property <string> tooltip;

    callback clicked();

    property <bool> bouncing: false;
    property <angle> spin_angle: 0deg;

    bounce_timer := Timer {
        interval: 170ms;
        running: false;
        triggered => {
            self.running = false;
            root.bouncing = false;
        }
    }

    width: 40px;
    height: 40px;

    touch_area := ExtendedTouchArea {
        tooltip: root.tooltip;

        clicked => {
            if root.spin_on_click {
                root.spin_angle += 90deg;
            } else {
                root.bouncing = true;
                bounce_timer.running = true;
            }
            root.clicked();
        }

        Rectangle {
            width: 100%;
            height: 100%;
            border_radius: 20px;
            background: root.active ? MaterialPalette.secondary_container : transparent;

            animate background { duration: 180ms; }

            StateLayer {
                width: 100%;
                height: 100%;
                background: root.active ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                border_radius: 20px;
                enabled: true;
                has_focus: touch_area.has_focus;
                has_hover: touch_area.has_hover;
                pressed: touch_area.pressed || touch_area.enter_pressed;

                if touch_area.pressed : Ripple {
                    width: parent.width;
                    height: parent.height;
                    border_radius: 20px;
                    pressed_x: touch_area.pressed_x;
                    pressed_y: touch_area.pressed_y;
                    color: MaterialPalette.on_surface;
                }
            }

            Icon {
                property <length> icon_dim: root.bouncing ? 24px : (touch_area.has_hover ? 22px : 20px);
                property <length> jump_y: root.bouncing ? -3px : 0px;

                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + self.jump_y;
                width: self.icon_dim;
                height: self.icon_dim;
                transform-rotation: root.spin_on_click ? (touch_area.has_hover && !root.active ? root.spin_angle + 30deg : root.spin_angle) : 0deg;
                source: root.active ? root.active_icon : root.icon;
                colorize: root.active ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;

                animate y { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                animate width { duration: 280ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                animate height { duration: 280ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                animate transform-rotation { duration: 500ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            }
        }
    }
}

export component DesktopSidebar {
    in property <[NavigationItem]> items;
    in_out property <int> current_index: 0;
    in property <bool> info_open: false;
    in property <bool> settings_open: false;

    callback index_changed(index: int);
    callback info_clicked();
    callback settings_clicked();

    width: 92px;

    // Background layer: recessed action rail with Info & Settings
    Rectangle {
        x: 0;
        y: 0;
        width: 68px;
        height: 100%;
        background: MaterialPalette.surface_container_high;
        border-top-right-radius: 16px;
        border-bottom-right-radius: 16px;

        VerticalLayout {
            padding_bottom: 24px;
            padding_right: 4px;
            alignment: end;

            HorizontalLayout {
                alignment: end;

                VerticalLayout {
                    width: 40px;
                    spacing: 12px;
                    alignment: center;

                    SidebarActionButton {
                        icon: OutlinedIcons.info;
                        active_icon: FilledIcons.info;
                        active: root.info_open;
                        tooltip: "Information";
                        clicked => {
                            root.info_clicked();
                        }
                    }

                    SidebarActionButton {
                        icon: OutlinedIcons.sidebar_settings;
                        active_icon: FilledIcons.sidebar_settings;
                        active: root.settings_open;
                        spin_on_click: true;
                        tooltip: "Settings";
                        clicked => {
                            root.settings_clicked();
                        }
                    }
                }
            }
        }
    }

    // Foreground layer: top navigation block + curved transition + bottom 20px strip
    VerticalLayout {
        x: 0;
        y: 0;
        width: 92px;
        height: 100%;
        spacing: 0px;

        Rectangle {
            width: 92px;
            vertical-stretch: 0;
            background: MaterialPalette.surface_container_low;
            border-top-right-radius: 16px;

            VerticalLayout {
                padding_top: 20px;
                padding_bottom: 8px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border_radius: 12px;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: AppAssets.launcher_icon;
                            image-fit: contain;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    padding_left: 4px;
                    padding_right: 4px;

                    for item[index] in root.items : SidebarNavButton {
                        icon: item.icon;
                        selected_icon: item.selected_icon;
                        text: item.text;
                        selected: index == root.current_index;
                        anim_kind: index;

                        clicked => {
                            root.current_index = index;
                            root.index_changed(index);
                        }
                    }
                }
            }
        }

        // Smooth asymmetric curve transition from 92px to 20px (1:1 viewbox)
        Path {
            width: 92px;
            height: 56px;
            vertical-stretch: 0;
            viewbox-width: 92;
            viewbox-height: 56;
            fill: MaterialPalette.surface_container_low;

            MoveTo { x: 92; y: 0; }
            CubicTo {
                control-1-x: 92;
                control-1-y: 28;
                control-2-x: 20;
                control-2-y: 28;
                x: 20;
                y: 56;
            }
            LineTo { x: 0; y: 56; }
            LineTo { x: 0; y: 0; }
            Close {}
        }

        // Bottom 20px strip leaving space for Info & Settings buttons on the right
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            Rectangle {
                x: 0;
                y: 0;
                width: 20px;
                height: 100%;
                background: MaterialPalette.surface_container_low;
                border-bottom-right-radius: 16px;
            }
        }
    }
}

export component MobileBottomNav {
    in property <[NavigationItem]> items;
    in_out property <int> current_index: 0;
    in property <bool> settings_open: false;

    callback index_changed(index: int);
    callback settings_clicked();

    height: 72px;
    vertical-stretch: 0;

    Rectangle {
        width: 100%;
        height: 100%;
        background: MaterialPalette.surface_container_low;

        VerticalLayout {
            HorizontalDivider {}

            HorizontalLayout {
                vertical-stretch: 1;
                padding_left: 8px;
                padding_right: 8px;
                padding_top: 6px;
                padding_bottom: 8px;
                alignment: space-around;

                for item[index] in root.items : SidebarNavButton {
                    icon: item.icon;
                    selected_icon: item.selected_icon;
                    text: item.text;
                    selected: index == root.current_index;
                    compact: true;
                    anim_kind: index;

                    clicked => {
                        root.current_index = index;
                        root.index_changed(index);
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    padding_left: 4px;
                    padding_right: 4px;

                    VerticalLayout {
                        alignment: center;
                        VerticalDivider {
                            height: 24px;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        SidebarActionButton {
                            icon: OutlinedIcons.sidebar_settings;
                            active_icon: FilledIcons.sidebar_settings;
                            active: root.settings_open;
                            spin_on_click: true;
                            tooltip: "Settings";
                            clicked => {
                                root.settings_clicked();
                            }
                        }
                    }
                }
            }
        }
    }
}
