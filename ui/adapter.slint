export struct EngineCardData {
    id: string,
    name: string,
    version: string,
    installed: bool,
    playtime_label: string,
}

export struct ModCardData {
    id: string,
    title: string,
    author: string,
    engine: string,
}

export struct FeaturedModCardData {
    id: string,
    title: string,
    author: string,
    engine: string,
    badge: string,
    cover: image,
    has_cover: bool,
}

export struct NewsItemData {
    title: string,
    source: string,
    summary: string,
}

export enum AppTab {
    home,
    library,
    instances,
    news,
}

export global MainWindowAdapter {
    in_out property <AppTab> active_tab: AppTab.home;
    in_out property <string> library_path: "";
    in_out property <string> status_message: "Iniciando...";
    in_out property <[EngineCardData]> engines: [];
    in_out property <[ModCardData]> mods: [];
    in_out property <[FeaturedModCardData]> featured_mods: [];
    in_out property <bool> featured_loading: true;
    in_out property <[NewsItemData]> news: [];
    in_out property <bool> info_open: false;
    in_out property <bool> settings_open: false;

    callback refresh_requested();
    callback search_mods(query: string);
    callback featured_mod_clicked(id: string);
    callback open_info();
    callback open_settings();
}
