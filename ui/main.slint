import { Palette } from "std-widgets.slint";
import {
    MaterialPalette,
    MaterialWindow,
    NavigationItem,
} from "@material";
import { AppTab, MainWindowAdapter } from "./adapter.slint";
import { FilledIcons, OutlinedIcons } from "./icons.slint";
import { DesktopSidebar, MobileBottomNav } from "./components/sidebar.slint";
import { ModDetailsModal } from "./components/mod_details_modal.slint";
import { SettingsModal } from "./components/settings_modal.slint";
import { AboutModal } from "./components/about_modal.slint";
import {
    CalloutToast,
    ConfirmDialog,
    CreateProfileDialog,
    NewsMediaModal,
} from "./components/dialogs.slint";
import { HomeView } from "./views/home_view.slint";
import { LibraryView } from "./views/library_view.slint";
import { InstancesView } from "./views/instances_view.slint";
import { NewsView } from "./views/news_view.slint";

export { MainWindowAdapter }

export component MainWindow inherits MaterialWindow {
    title: "WeekBox (wb-r)";
    preferred-width: 1120px;
    preferred-height: 740px;
    min-width: 420px;
    min-height: 500px;
    background: MaterialPalette.background;

    property <bool> compact_layout: root.width < 760px;
    property <bool> is_dark: MainWindowAdapter.dark_mode;

    init => {
        Palette.color_scheme = MainWindowAdapter.dark_mode ? ColorScheme.dark : ColorScheme.light;
    }

    changed is_dark => {
        Palette.color_scheme = root.is_dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <[NavigationItem]> nav_items: [
        {
            text: "Inicio",
            icon: OutlinedIcons.home,
            selected_icon: FilledIcons.home,
        },
        {
            text: "Biblioteca",
            icon: OutlinedIcons.library,
            selected_icon: FilledIcons.library,
        },
        {
            text: "Instancias",
            icon: OutlinedIcons.instances,
            selected_icon: FilledIcons.instances,
        },
        {
            text: "Noticias",
            icon: OutlinedIcons.news,
            selected_icon: FilledIcons.news,
        },
    ];

    function tab_to_index(tab: AppTab) -> int {
        if tab == AppTab.home {
            return 0;
        } else if tab == AppTab.library {
            return 1;
        } else if tab == AppTab.instances {
            return 2;
        }
        return 3;
    }

    function set_tab_by_index(idx: int) {
        if idx == 0 {
            MainWindowAdapter.active_tab = AppTab.home;
        } else if idx == 1 {
            MainWindowAdapter.active_tab = AppTab.library;
        } else if idx == 2 {
            MainWindowAdapter.active_tab = AppTab.instances;
        } else if idx == 3 {
            MainWindowAdapter.active_tab = AppTab.news;
        }
    }

    if !root.compact_layout : HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        DesktopSidebar {
            items: root.nav_items;
            current_index: root.tab_to_index(MainWindowAdapter.active_tab);
            info_open: MainWindowAdapter.info_open;
            settings_open: MainWindowAdapter.settings_open;

            index_changed(index) => {
                root.set_tab_by_index(index);
            }

            info_clicked => {
                MainWindowAdapter.open_info();
            }

            settings_clicked => {
                MainWindowAdapter.open_settings();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            if MainWindowAdapter.active_tab == AppTab.home : HomeView {
                width: 100%;
                height: 100%;
            }
            if MainWindowAdapter.active_tab == AppTab.library : LibraryView {
                width: 100%;
                height: 100%;
            }
            if MainWindowAdapter.active_tab == AppTab.instances : InstancesView {
                width: 100%;
                height: 100%;
            }
            if MainWindowAdapter.active_tab == AppTab.news : NewsView {
                width: 100%;
                height: 100%;
            }
        }
    }

    if root.compact_layout : VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        Rectangle {
            vertical-stretch: 1;
            if MainWindowAdapter.active_tab == AppTab.home : HomeView {
                width: 100%;
                height: 100%;
            }
            if MainWindowAdapter.active_tab == AppTab.library : LibraryView {
                width: 100%;
                height: 100%;
            }
            if MainWindowAdapter.active_tab == AppTab.instances : InstancesView {
                width: 100%;
                height: 100%;
            }
            if MainWindowAdapter.active_tab == AppTab.news : NewsView {
                width: 100%;
                height: 100%;
            }
        }

        MobileBottomNav {
            items: root.nav_items;
            current_index: root.tab_to_index(MainWindowAdapter.active_tab);
            settings_open: MainWindowAdapter.settings_open;

            index_changed(index) => {
                root.set_tab_by_index(index);
            }

            settings_clicked => {
                MainWindowAdapter.open_settings();
            }
        }
    }

    // Top-level modals & notifications
    ModDetailsModal {}
    SettingsModal {}
    AboutModal {}
    CreateProfileDialog {}
    ConfirmDialog {}
    NewsMediaModal {}
    CalloutToast {}
}
